{
  "name": "@torpc/toevm-rules",
  "version": "0.0.1",
  "private": true,
  "description": "Partial reference of the T1 transformation primitives of TORPC (Token Optimized RPC), targeting EVM RPC Compression v1 (specs/evm-v1.md): token-efficient Ethereum JSON-RPC responses for AI agent consumption.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rules/*": "./src/rules/*.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "torpc",
    "toevm",
    "ethereum",
    "json-rpc",
    "agent",
    "compression",
    "ai",
    "llm"
  ],
  "license": "Apache-2.0"
}
