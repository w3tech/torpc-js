{
  "name": "agent-rpc-bench",
  "version": "0.0.1",
  "private": true,
  "description": "Reproducible benchmark suite comparing agent-native RPC formats vs raw JSON-RPC on real ETH mainnet data. Measures token efficiency and retrieval accuracy.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "capture:tiers": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runner/capture-tiers.ts",
    "questions": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/questions/generate.ts",
    "tokens": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runner/token-bench.ts",
    "exam": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runner/build-exam.ts",
    "score": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runner/score-answers.ts",
    "eval:api": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runner/run-api.ts",
    "consolidate": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runner/consolidate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "install-hooks": "bash scripts/install-hooks.sh",
    "prepare": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@toon-format/toon": "^2.2.0",
    "dotenv": "^16.4.5",
    "gpt-tokenizer": "^2.4.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.5.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "license": "Apache-2.0"
}
